{
  "manifest_version": 3,
  "name": "Jev Ultrafast",
  "version": "0.1.0",
  "description": "Give one goal; Jev drives the current tab. Browser Use × TypeSafe.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "sidePanel", "storage", "tabs"],
  "host_permissions": ["https://api.typesafe.ai/*", "https://openrouter.ai/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "panel.html" },
  "action": { "default_title": "Jev Ultrafast" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+J", "mac": "Command+Shift+J" } }
  }
}
